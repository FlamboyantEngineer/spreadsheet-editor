{
  "name": "@flamboyantengineer/spreadsheet-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable React spreadsheet editor with exact arithmetic and interchangeable client/server calculation.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/spreadsheet-editor.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calculation": {
      "types": "./dist/calculation/index.d.ts",
      "import": "./dist/calculation/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./excel": {
      "types": "./dist/excel/index.d.ts",
      "import": "./dist/excel/index.js"
    },
    "./reference.css": "./dist/reference.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "specs",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "build:labs": "node scripts/build-labs.mjs",
    "labs": "node scripts/labs.mjs",
    "test:labs": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "check:references": "ui-components-tooling check-references",
    "check:structure": "ui-components-tooling check-structure",
    "check:exports": "ui-components-tooling check-exports",
    "check:consumer": "node scripts/check-consumer.mjs",
    "changeset": "changeset",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:references && npm run check:structure && npm run check:exports && npm test && npm run build && npm run check:package && npm run check:consumer && npm run test:labs"
  },
  "peerDependencies": {
    "@flamboyantengineer/ui-components": "~0.1.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "parse5": "^8.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "parse5": {
      "optional": true
    }
  },
  "dependencies": {
    "@jspreadsheet-ce/react": "5.0.2",
    "decimal.js": "10.6.0",
    "jspreadsheet-ce": "5.0.4",
    "jsuites": "5.13.5"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.7"
    },
    "eslint": {
      "minimatch": "11.0.7"
    },
    "archiver-utils": {
      "glob": "14.0.4"
    },
    "exceljs": {
      "archiver": "7.0.1",
      "fast-csv": "5.0.8",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@flamboyantengineer/ui-components": "git+https://github.com/FlamboyantEngineer/ui-components.git#12b5bff8f5a8b59889715f70491e5d687c9d45d5",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "parse5": "8.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
