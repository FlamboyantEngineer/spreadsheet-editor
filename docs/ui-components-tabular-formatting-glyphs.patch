+import { render, screen } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { expectHooksMatchSpec } from '../../test/hooks.js';
+import { Icon } from '../components/icon/icon.js';
+import * as formattingGlyphs from './formatting-glyphs.js';
+import type { GlyphComponentProps, GlyphMap } from './glyph-types.js';
+import * as core from './index.js';
+import { UiProvider } from './provider.js';
+
+function ReplacementGlyph(props: GlyphComponentProps) {
+  return (
+    <svg {...props}>
+      <circle cx="12" cy="12" r="5" />
+    </svg>
+  );
+}
+
+describe('formatting glyphs', () => {
+  it.each(Object.entries(formattingGlyphs))(
+    'UIC-PROVIDER-2.1 exports %s as a decorative normalized outline',
+    (exportName, Component) => {
+      expect(core[exportName as keyof typeof formattingGlyphs]).toBe(Component);
+      const name = Component.glyphName;
+      const { container } = render(<Icon icon={Component} label={name} />);
+      const image = screen.getByRole('img', { name });
+      expect(image).toHaveAttribute('data-glyph', name);
+      const svg = image.querySelector('.ui-icon__glyph');
+      expect(svg).toHaveAttribute('viewBox', '0 0 24 24');
+      expect(svg).toHaveAttribute('stroke', 'currentColor');
+      expect(svg).toHaveAttribute('stroke-width', '1.5');
+      expect(svg).toHaveAttribute('fill', 'none');
+      expect(svg).toHaveAttribute('aria-hidden', 'true');
+      expect(svg).toHaveAttribute('focusable', 'false');
+      expect(svg).not.toHaveAttribute('style');
+      expect(svg).not.toHaveAttribute('width');
+      expect(svg).not.toHaveAttribute('height');
+      expect(svg?.querySelector('path')).toHaveAttribute('stroke-linecap', 'round');
+      expect(svg?.querySelector('path')).toHaveAttribute('stroke-linejoin', 'round');
+      expectHooksMatchSpec(container, 'ICON', { slots: 'all' });
+    },
+  );
+
+  it.each(Object.entries(formattingGlyphs))(
+    'UIC-PROVIDER-2.2 replaces %s through its typed provider key',
+    (_exportName, Component) => {
+      const name = Component.glyphName;
+      const icons: Partial<GlyphMap> = { [name]: ReplacementGlyph };
+      render(
+        <UiProvider icons={icons}>
+          <Icon icon={Component} label={name} />
+        </UiProvider>,
+      );
+      const image = screen.getByRole('img', { name });
+      expect(image.querySelector('circle')).toHaveAttribute('r', '5');
+      expect(image.querySelector('path')).toBeNull();
+      expect(image.querySelector('svg')).toHaveAttribute('aria-hidden', 'true');
+      expect(image.querySelector('svg')).toHaveAttribute('focusable', 'false');
+      expect(image.querySelector('svg')).toHaveAttribute('data-glyph', name);
+    },
+  );
+
+  it('UIC-PROVIDER-2.1 UIC-PROVIDER-2.2 accepts the defaults as provider overrides without recursion', () => {
+    const icons = Object.fromEntries(
+      Object.values(formattingGlyphs).map((Component) => [Component.glyphName, Component]),
+    );
+    render(
+      <UiProvider icons={icons}>
+        {Object.values(formattingGlyphs).map((Component) => (
+          <Icon key={Component.glyphName} icon={Component} label={Component.glyphName} />
+        ))}
+      </UiProvider>,
+    );
+    expect(screen.getAllByRole('img')).toHaveLength(31);
+  });
+});
