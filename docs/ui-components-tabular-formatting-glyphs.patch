 import { cellSelector, expect, matrixCell, test } from './fixtures.js';
 
 test.describe('Icon lab', () => {
+  test('UIC-PROVIDER-2.1 draws distinct formatting marks at toolbar sizes in both themes', async ({
+    page,
+    lab,
+  }) => {
+    await lab.open('icon');
+    for (const theme of ['light', 'dark']) {
+      await page.evaluate(
+        (value) => document.documentElement.setAttribute('data-theme', value),
+        theme,
+      );
+      const glyphs = page.locator('[data-lab-formatting] [data-size="md"]');
+      await expect(glyphs).toHaveCount(31);
+      const drawings = await glyphs.evaluateAll(async (icons) => {
+        const results: string[] = [];
+        for (const icon of icons) {
+          const svg = icon.querySelector('svg');
+          if (!svg) throw new Error('Missing formatting glyph');
+          const clone = svg.cloneNode(true) as SVGElement;
+          clone.setAttribute('width', '16');
+          clone.setAttribute('height', '16');
+          clone.setAttribute('stroke', getComputedStyle(svg).color);
+          const image = new Image();
+          image.src = 'data:image/svg+xml,' + encodeURIComponent(clone.outerHTML);
+          await image.decode();
+          const canvas = document.createElement('canvas');
+          canvas.width = 16;
+          canvas.height = 16;
+          const context = canvas.getContext('2d');
+          if (!context) throw new Error('Missing canvas context');
+          context.drawImage(image, 0, 0);
+          results.push(canvas.toDataURL());
+        }
+        return results;
+      });
+      expect(new Set(drawings).size, `${theme} formatting glyphs remain distinct at 16px`).toBe(31);
+    }
+  });
+
   test('UIC-ICON-1.1 UIC-ICON-1.2 draws every glyph in three box sizes', async ({ page, lab }) => {
     await lab.open('icon');
     const cells = page.locator('table[data-lab-matrix="glyph size"] td[data-lab-cell]');
